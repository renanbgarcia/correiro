NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=correiro
MYSQL_USER=correiro
MYSQL_PASSWORD=correiro_local
MYSQL_CONNECTION_LIMIT=10

# Gere valores longos e aleatórios em produção.
SESSION_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
TOKEN_ENCRYPTION_KEY=troque-por-uma-chave-distinta-com-pelo-menos-32-caracteres
SESSION_TTL_DAYS=30

META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_REDIRECT_URI=http://localhost:3000/api/channels/meta/callback
META_DEMO_MODE=true

# Alternativa gerenciada: exige somente a chave do projeto Composio.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=
COMPOSIO_CALLBACK_URL=http://localhost:3000/api/channels/composio/callback
COMPOSIO_FACEBOOK_VERSION=20260721_00
COMPOSIO_INSTAGRAM_VERSION=20260721_00

STORAGE_DIR=./storage
MAX_IMAGE_MB=20
MAX_VIDEO_MB=100

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Correiro <nao-responda@correiro.local>

WORKER_POLL_MS=3000
WORKER_CONCURRENCY=3
WORKER_MAX_ATTEMPTS=4
WORKER_INLINE=true
LOG_LEVEL=info
